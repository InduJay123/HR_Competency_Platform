DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-random-secret-at-least-50-characters
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://bfl:replace-with-random-local-password@127.0.0.1:5432/bfl
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=bfl-evidence
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
OPENAI_MODEL=
# Review analysis uses the n8n credential store. Corporate trainer uses these server-only settings.
OPENAI_API_KEY=
OPENAI_TRAINER_MODEL=
FRONTEND_URL=http://127.0.0.1:3000
PRIVATE_STORAGE_BACKEND=local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
